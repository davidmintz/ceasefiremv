{% extends 'wrapper.html.twig' %}
{% block title %}Confirm your RSVP | {{ parent() }}{% endblock %}
{% block content %}
    <h2 class="text-center my-4">Confirm your RSVP</h2>
    <p class="lead text-center">{{ meeting.title }}<br><strong>{{ meeting.when }}</strong></p>
    <dl class="row">
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">{{ rsvp.name }}</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">{{ rsvp.email }}</dd>
        <dt class="col-sm-3">Attending</dt><dd class="col-sm-9">{{ rsvp.mode.label }}</dd>
    </dl>
    <form method="post" action="{{ path('rsvp_confirm', {token: token}) }}" class="text-center">
        <input type="hidden" name="_token" value="{{ csrf_token('rsvp_confirm') }}">
        <button type="submit" class="btn btn-primary btn-lg">Confirm</button>
    </form>
    <p class="small text-muted mt-4">
        Something wrong? <a href="{{ path('rsvp') }}">Fill out the form again</a> with the same email address.
    </p>
{% endblock %}
